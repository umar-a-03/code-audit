# ===========================================
# Application Configuration
# ===========================================
APP_NAME="Code Audit API"
APP_VERSION="1.0.0"
DEBUG=true
ENVIRONMENT=development

# ===========================================
# Database
# ===========================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/codeaudit
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ===========================================
# Redis
# ===========================================
REDIS_URL=redis://localhost:6379/0

# ===========================================
# Security
# ===========================================
# Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-key-here-generate-with-cryptography

# JWT Settings
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ===========================================
# Supabase (Google OAuth)
# ===========================================
# Get from: https://supabase.com/dashboard
# Create a project → Authentication → Providers → Google
# Add redirect URL: http://localhost:5164/auth/callback
SUPABASE_URL=your-supabase-project-url
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ===========================================
# CORS
# ===========================================
CORS_ORIGINS=["http://localhost:5164","http://localhost:5164"]

# ===========================================
# File Storage
# ===========================================
STORAGE_TYPE=local
UPLOAD_DIR=./uploads

# ===========================================
# AWS S3 (if using S3 storage)
# ===========================================
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-bucket-name

# ===========================================
# Worker Settings
# ===========================================
RQ_QUEUE_NAME=default
RQ_JOB_TIMEOUT=3600
RQ_RESULT_TTL=86400

# ===========================================
# Rate Limiting
# ===========================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# ===========================================
# Analysis Settings
# ===========================================
MAX_CONCURRENT_JOBS_PER_CLIENT=5
ANALYSIS_TIMEOUT_SECONDS=3600
MAX_REPO_SIZE_MB=500

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=INFO
# LOG_FILE=./logs/app.log

# ===========================================
# Feature Flags
# ===========================================
ENABLE_GOOGLE_AUTH=true
ENABLE_GITHUB_AUTH=false  # Using Supabase instead
ENABLE_BATCH_ANALYSIS=true
ENABLE_SCHEDULING=false
